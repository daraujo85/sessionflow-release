def _colab_info(w):
    label = f"{w.get('display_name') or ''} {w.get('hostname') or ''} {w.get('host_id') or ''}".lower()
    # Kaggle: sandbox efêmero igual ao Colab, mas a "URL de ligar" é o notebook
    # do usuário, não /drive/<id>. Sem isso `sf start kaggle` abriria Colab.
    if "kaggle" in label or "d060d384" in label:
        return {
            "is_sandbox": True,
            "is_kaggle": True,
            "is_colab": False,
            "authuser": None,
            "is_gpu": "gpu" in label or bool((w.get("hardware") or {}).get("gpu")),
            # NÃO existe `ssh kaggle` (~/.ssh/config) nem túnel bore no
            # selfboot. Um alias aqui faria o `sf stop` rodar `ssh kaggle
            # pkill ...`, falhar em silêncio (rc ignorado) e o worker seguir
            # vivo — o host voltaria a 🟢 em ~90s. O desligamento real no
            # Kaggle é o comando `shutdown` publicado pela API.
            "alias": None,
            "url": os.environ.get(
                "SF_KAGGLE_URL",
                "https://www.kaggle.com/code/diegoaraujo85/notebooke5f51f72d8",
            ) + "/edit",
        }
    is_colab2 = "colab 2" in label or "colab2" in label or "02151543" in label
    authuser = "1" if is_colab2 else "0"
    is_gpu = "gpu" in label or "t4" in label or (w.get("hardware") or {}).get("gpu")
    alias = "colab2-pro" if (is_colab2 and is_gpu) else ("colab2-cpu" if is_colab2 else ("colab1-pro" if is_gpu else "colab1-cpu"))
    url = f"https://colab.research.google.com/drive/1MLzqvoeSg_JeMywj4HzvyRKTmssieZH5?authuser={authuser}"
    return {
        "is_sandbox": True,
        "is_kaggle": False,
        "is_colab": is_colab(w),
        "authuser": authuser,
        "is_gpu": bool(is_gpu),
        "alias": alias,
        "url": url,
    }


