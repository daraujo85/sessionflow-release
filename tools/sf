    # Mata processos remotos e túneis locais se SSH estiver configurado.
    # Kaggle tem `alias=None` de propósito (não existe SSH lá): quem encerra
    # o worker é o comando `shutdown` publicado pelo POST /stop acima.
    if alias:
        subprocess.run(["ssh", "-o", "ConnectTimeout=3", alias, "pkill -9 -f bore; pkill -9 -f sessionflow_worker"], capture_output=True, check=False)
        subprocess.run(["pkill", "-f", f"ssh.*{alias}"], capture_output=True, check=False)
        subprocess.run(["pkill", "-f", "ssh.*colab-worker"], capture_output=True, check=False)
    elif info.get("is_kaggle"):
        print("   (Kaggle: sem SSH — o worker recebe 'shutdown' e encerra sozinho;")
        print("    a sessão do notebook continua aberta no navegador)")

    print(f"🛑 {label} desligado com sucesso.")


