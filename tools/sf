def _relative_artifact(value: str, work_dir: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ValueError("referência de contexto deve ser texto não vazio")
    path = Path(value)
    if path.is_absolute() or ".." in path.parts:
        raise ValueError(f"referência fora do work_dir: {value}")
    root = Path(work_dir).resolve()
    resolved = (root / path).resolve()
    if root not in (resolved, *resolved.parents) or not resolved.exists():
        raise ValueError(f"artefato não encontrado no work_dir: {value}")
    return str(resolved.relative_to(root))


def load_context_file(path: str | None, work_dir: str) -> dict[str, Any]:
    if not path:
        return {}
    source = Path(path).expanduser().resolve()
    if not source.is_file() or source.stat().st_size > MAX_CONTEXT_FILE_BYTES:
        raise ValueError("--context-file ausente ou maior que 32KB")
    try:
        raw = json.loads(source.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise ValueError(f"--context-file não é JSON válido: {exc.msg}") from exc
    if not isinstance(raw, dict) or set(raw) - _CONTEXT_FIELDS:
        raise ValueError("--context-file contém chaves não permitidas")
    context: dict[str, Any] = {}
    for key, value in raw.items():
        values = [value] if key == "scope" and isinstance(value, str) else value
        if not isinstance(values, list) or not values or any(not isinstance(v, str) or not v.strip() for v in values):
            raise ValueError(f"contexto inválido em '{key}'")
        context[key] = [_relative_artifact(v, work_dir) for v in values] if key == "paths" else values
    return context


def resolve_role(role: str | None, work_dir: str) -> dict[str, str] | None:
    if not role:
        return None
    if not _ROLE_RE.fullmatch(role):
        raise ValueError("--role deve ser slug seguro (a-z, 0-9, -)")
    persona = ROLE_PERSONAS_DIR / f"{role}.md"
    if not persona.is_file():
        raise ValueError(f"persona global não encontrada: {persona}")
    overlay = Path(work_dir) / ".claude" / "sf" / f"{role}.md"
    result = {"name": role, "persona": str(persona)}
    if overlay.is_file():
        result["overlay"] = str(overlay)
    return result


def validate_handoff(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict) or set(data) != _HANDOFF_FIELDS:
        raise ValueError("handoff deve conter exatamente campos do contrato")
    if data.get("schema_version") != MANIFEST_VERSION or data.get("status") not in _HANDOFF_STATUSES:
        raise ValueError("versão ou status de handoff inválido")
    if not isinstance(data.get("summary"), str) or not data["summary"].strip():
        raise ValueError("summary de handoff obrigatório")
    for key in _HANDOFF_FIELDS - {"schema_version", "status", "summary"}:
        if not isinstance(data.get(key), list) or any(not isinstance(v, str) or not v.strip() for v in data[key]):
            raise ValueError(f"{key} deve ser lista de textos não vazios")
    return data


def build_manifest(args, work_dir: str, name: str, role: dict[str, str] | None, context: dict[str, Any]) -> dict[str, Any]:
    return {
        "schema_version": MANIFEST_VERSION,
        "name": name,
        "objective": args.task,
        "role": role,
        "context": context,
        "execution": {"provider": args.provider, "model": args.model, "effort": args.effort},
        "done_criteria": context.get("done_criteria", []),
        "created_at": datetime.now(timezone.utc).isoformat(),
    }


def _json_bytes(value: Any) -> int:
    return len(json.dumps(value, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))


def read_metrics(work_dir: str) -> list[dict[str, Any]]:
    """Lê somente manifests/handoffs locais; nunca API, Markdown ou transcript."""
    metrics = []
    for manifest_file in sorted(Path(handoff_dir(work_dir)).glob("*.manifest.json")):
        name = manifest_file.name.removesuffix(".manifest.json")
        entry = {
            "name": name, "task_bytes": 0, "context_bytes": 0,
            "manifest_bytes": manifest_file.stat().st_size, "handoff_bytes": 0,
            "role": "-", "status": "invalid", "violations": [],
        }
        try:
            manifest = json.loads(manifest_file.read_text(encoding="utf-8"))
            if not isinstance(manifest, dict) or not isinstance(manifest.get("objective"), str) or not isinstance(manifest.get("context"), dict):
                raise ValueError("manifest inválido")
            role = manifest.get("role")
            if role is not None and (not isinstance(role, dict) or not isinstance(role.get("name"), str)):
                raise ValueError("role inválido")
            entry["task_bytes"] = len(manifest["objective"].encode("utf-8"))
            entry["context_bytes"] = _json_bytes(manifest["context"])
            entry["role"] = role["name"] if role else "-"
            entry["status"] = "missing"
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            entry["error"] = str(exc)
            metrics.append(entry)
            continue

        handoff_file = Path(handoff_json_path(work_dir, name))
        if handoff_file.exists():
            entry["handoff_bytes"] = handoff_file.stat().st_size
            try:
                entry["status"] = validate_handoff(json.loads(handoff_file.read_text(encoding="utf-8")))["status"]
            except (OSError, json.JSONDecodeError, ValueError) as exc:
                entry["status"] = "invalid"
                entry["error"] = str(exc)
        for key, budget in (("task_bytes", TASK_BUDGET_BYTES), ("context_bytes", CONTEXT_BUDGET_BYTES), ("handoff_bytes", HANDOFF_BUDGET_BYTES)):
            if entry[key] > budget:
                entry["violations"].append(f"{key}>{budget}")
        metrics.append(entry)
    return metrics


def build_handoff_task(task, work_dir, name, manifest=None, finish_steps=None):
    """Monta o texto injetado no filho: a tarefa + bloco de HANDOFF (PT-BR)."""
    md_path = handoff_md_path(work_dir, name)
    handoff_path = handoff_json_path(work_dir, name)
    manifest_note = f"\nManifest de contexto (leia referências seletivamente; nunca puxe transcript):\n  {manifest}\n" if manifest else ""
    return (
        f"{task}\n{manifest_note}\n"
        "----- INSTRUÇÕES DE HANDOFF (worker delegado) -----\n"
        "Você é um WORKER DELEGADO. Execute SOMENTE esta tarefa, de forma "
        "AUTÔNOMA — não peça confirmação nem faça perguntas. Ao terminar, "
        "escreva um resumo OBJETIVO do resultado (o que você fez; arquivos/"
        "PRs/commits envolvidos; como validar; pendências ou bloqueios) no "
        f"arquivo:\n  {md_path}\n"
        "Além do Markdown, escreva JSON válido neste contrato exato:\n"
        f"  {handoff_path}\n"
        "{\"schema_version\":1,\"status\":\"done|blocked|failed\",\"summary\":\"...\","
        "\"diff\":[\"...\"],\"tests\":[\"...\"],\"blockers\":[\"...\"],\"questions\":[\"...\"]}\n"
        "Use listas vazias quando não houver itens. Crie o diretório se necessário. "
        f"{finish_steps or 'Depois de escrever ambos, PARE — não faça mais nada.'}\n\n"
        "----- FERRAMENTAS DE COORDENAÇÃO (sf) -----\n"
        "Você tem acesso ao comando `sf` (já no PATH deste host — funciona "
        "de qualquer diretório, com qualquer provedor de agente, não é "
        "específico do Claude Code). Use quando fizer sentido:\n"
        "- `sf list` — lista TODAS as sessões ativas (nome, agente, status, "
        "host) — inclusive em OUTRAS estações/máquinas, não só a sua.\n"
        "- `sf send <sessão> \"texto\"` — manda uma mensagem/instrução direto "
        "pro terminal de outra sessão já rodando, mesmo em outro host — o "
        "roteamento é sempre pela API central, então funciona entre "
        "estações diferentes normalmente.\n"
        "- `sf share <arquivo> --to <sessão>` — compartilha um arquivo do "
        "seu disco com OUTRA sessão (mesmo em outro host) — fica disponível "
        "pra ela via API (GET /sessions/{id}/shared-files + "
        "/shared-files/{id}/download); sem --to, compartilha na sua própria "
        "sessão (visível no app, inclusive celular).\n\n"
        "Se OUTRA sessão te mandar uma mensagem (via `sf send`) enquanto "
        "você trabalha, RESPONDA de volta pra ela (também via `sf send`) "
        "pra manter o fluxo de conversa — continue trocando mensagens até "
        "que a necessidade daquela conversa esteja de fato resolvida, em "
        "vez de responder só uma vez e parar."
    )


def _is_literal_remote_path(s):
    """Verifica se s é caminho literal (/ ou ~ ou ~/...), não um nome indexado."""
    return s.startswith("/") or s == "~" or s.startswith("~/")


def resolve_remote_dir(dir_arg, dirs, local_home):
    """`--dir` p/ host remoto: caminho literal (/ ou ~) ou NOME indexado no host.

    `dirs` = itens de GET /directories (só usado no modo nome). ValueError em
    caminho expandido pelo shell local, nome ambíguo ou ausente.
    """
    home = local_home.rstrip("/")
    if dir_arg == home or dir_arg.startswith(home + "/"):
        raise ValueError(
            f"'{dir_arg}' é caminho DESTE host (o shell expandiu `~` localmente); "
            "use aspas: --dir '~/...'"
        )
    if _is_literal_remote_path(dir_arg):
        return {"path": dir_arg, "is_git": None}
    exact = [d for d in dirs if d.get("name") == dir_arg]
    candidates = exact or dirs
    if len(candidates) == 1:
        return {"path": candidates[0]["path"], "is_git": candidates[0].get("is_git")}
    if not candidates:
        raise ValueError(
            f"nenhuma pasta '{dir_arg}' indexada no host; veja `sf dirs --host <alias> {dir_arg}`"
        )
    raise ValueError(
        f"'{dir_arg}' ambíguo no host: " + ", ".join(d["path"] for d in candidates)
        + " — passe o caminho completo entre aspas"
    )


def build_remote_task(task, work_dir, name, manifest, parent, push, branch=None):
    """Tarefa p/ filho em OUTRO host: manifest inline + entrega git + share/send.

    `branch` = branch name (ex. "sf/w1") para push. Se None, usa HEAD (compatibilidade).
    """
    md_path = handoff_md_path(work_dir, name)
    json_path = handoff_json_path(work_dir, name)
    patch_path = os.path.join(handoff_dir(work_dir), f"{name}.patch")
    manifest_json = json.dumps(manifest, ensure_ascii=False, separators=(",", ":"))
    if push:
        # push a branch explícita em vez de HEAD
        push_branch = branch or "HEAD"
        deliver = (f"2. `git push -u origin {push_branch}`; ponha a branch (`git branch --show-current`) "
                   "e o SHA final no `diff` do JSON.\n")
    else:
        deliver = (f"2. `git format-patch <BASE>..HEAD --stdout > {patch_path}` "
                   "(BASE = SHA do PASSO 0); cite o arquivo no `diff` do JSON.\n")
    body = (
        f"{task}\n\n"
        "Manifest de contexto (JSON inline; leia referências seletivamente; nunca puxe transcript):\n"
        f"{manifest_json}\n\n"
        "----- ENTREGA GIT (ao concluir, ANTES do handoff) -----\n"
        "1. Commit de todas as mudanças, sem `.sessionflow/`: "
        "`git add -A -- . ':!.sessionflow' && git commit -m \"<mensagem descritiva>\"`.\n"
        + deliver
    )
    files = [md_path, json_path] + ([] if push else [patch_path])
    finish = (
        "Depois de escrever ambos:\n"
        + "".join(f"- `sf share {path}`\n" for path in files)
        + "(pule arquivo que não existir)\n"
        + (f"- `sf send {parent} \"✅ HANDOFF {name} status=<status do JSON>\"`\n" if parent else "")
        + "Então PARE — não faça mais nada."
    )
    return (
        "PASSO 0 (ANTES DE QUALQUER COISA): rode `git rev-parse HEAD` neste diretório e "
        "anote o SHA como BASE. Se não for repositório git, ignore todos os passos de git.\n\n"
        + build_handoff_task(body, work_dir, name, finish_steps=finish)
    )


