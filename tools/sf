# Limite do polling: requests pequenos, ~10 req/s. 30s cobre leitura de até
# ~1 MiB em worker remoto (largura do fs_fetch é curta, 1 MiB de payload).
_FETCH_POLL_TIMEOUT = 30.0
_FETCH_POLL_INTERVAL = 0.25


def _resolve_remote_host_id(args):
    """Resolve alias/emoji/host_id pra um host_id REAL, usando ``sf hosts``.

    Falha se o host não estiver cadastrado (worker nunca fez heartbeat) ou
    se o alias for ambíguo. Aceita ``--remote`` igual aos outros comandos —
    roteia contra uma instância SF de outro amigo/deploy.
    """
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    status, body = _request("GET", f"{base}/workers", token=token, timeout=15)
    if status != 200:
        die(f"GET /workers falhou (HTTP {status}): {body}")
    workers = body if isinstance(body, list) else []
    try:
        host = resolve_host(workers, args.target_host, allow_offline=False)
    except ValueError as exc:
        die(str(exc))
    return host["host_id"]


def cmd_fetch(args):
    """Lê 1 arquivo de OUTRO host via SessionFlow (sem precisar de sessão).

    Publica um comando ``fs_fetch`` na fila do worker do host alvo via API;
    o worker grava o resultado em ``command_results``; este CLI faz polling
    em ``GET /commands/{command_id}`` e imprime o conteúdo.

    Saída:
      - arquivo texto → imprime direto na stdout
      - arquivo binário OU ``--out`` → escreve no destino (decodifica base64)
      - erro → exit code 2 com mensagem
    """
    host_id = _resolve_remote_host_id(args)
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)

    status, body = _request(
        "POST",
        f"{base}/hosts/{host_id}/fetch",
        token=token,
        body={"path": args.path},
        timeout=15,
    )
    if status != 202 or "command_id" not in body:
        die(f"fetch enfileirar falhou (HTTP {status}): {body}")
    command_id = body["command_id"]

    timeout = getattr(args, "timeout", None) or _FETCH_POLL_TIMEOUT
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        time.sleep(_FETCH_POLL_INTERVAL)
        status, body = _request(
            "GET", f"{base}/commands/{command_id}", token=token, timeout=10,
        )
        if status != 200:
            die(f"polling /commands falhou (HTTP {status}): {body}")
        st = body.get("status")
        if st == "ok":
            _emit_fetch_result(host_id, body.get("result") or {}, args)
            return
        if st == "error":
            err = body.get("error") or "erro desconhecido"
            die(f"fetch em {host_id} falhou: {err}", code=2)
        # status == "pending" → continua polling
    die(f"timeout aguardando fetch em {host_id} ({timeout:.0f}s)", code=2)


def _emit_fetch_result(host_id: str, result: dict, args) -> None:
    """Imprime texto na stdout OU grava binário em ``--out`` / base64 em stdout."""
    out_path = getattr(args, "out", None)
    truncated = result.get("truncated", False)
    returned = result.get("returned_bytes", 0)
    total = result.get("size_bytes", returned)
    binary = result.get("binary", False)

    if binary or out_path:
        # binário OU --out: sempre grava arquivo. Sem --out usa /tmp/<cmd>-<id>.
        import base64 as _b64
        import uuid as _uuid
        if binary:
            payload = _b64.b64decode(result.get("content_b64", ""))
        else:
            payload = result.get("text", "").encode("utf-8")
        target = out_path or f"/tmp/sf-fetch-{_uuid.uuid4().hex[:8]}"
        Path(target).write_bytes(payload)
        kind = "binário" if binary else "texto→arquivo"
        print(
            f"fetch ✅ <{host_id}> {result.get('path')} "
            f"({returned}/{total} bytes, {kind}) → {target}"
        )
        if truncated:
            print(f"  ⚠️  truncado em {returned} bytes (limite 1 MiB)")
        return

    # texto sem --out: imprime direto
    text = result.get("text", "")
    sys.stdout.write(text)
    if not text.endswith("\n"):
        sys.stdout.write("\n")
    print(
        f"-- ({returned}/{total} bytes de {result.get('path')} em {host_id})",
        file=sys.stderr,
    )
    if truncated:
        print("  ⚠️  truncado em 1 MiB", file=sys.stderr)


# --------------------------------------------------------------------------- #
# comando: share
# --------------------------------------------------------------------------- #
def cmd_share(args):
    """Sobe um arquivo do disco pra ficar disponível no app (inclusive celular).

    Resolve a sessão de destino em duas etapas: `--to <alvo>` explícito, ou
    (default) a PRÓPRIA sessão de onde o comando roda (via `detect_parent()`,
    que lê `$TMUX`) — o caso de uso comum é o agente compartilhar um arquivo
    que ele mesmo acabou de gerar, na sessão em que já está.
    """
    path = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.isfile(path):
        die(f"arquivo não encontrado: {path}")

    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    sessions = list_sessions(env, token)

    target_name = args.to or detect_parent()
    if not target_name:
        cwd = os.path.realpath(os.getcwd())
        for s in sessions:
            swd = os.path.realpath(s.get("work_dir") or "")
            if swd and swd != "/" and (cwd == swd or cwd.startswith(swd + "/") or swd.startswith(cwd + "/")):
                target_name = s.get("tmux_name") or s.get("id")
                break
    if not target_name:
        die("não rodando dentro de um tmux do SessionFlow e nenhum --to informado; "
            "especifique a sessão com --to <nome-ou-id>")

    session = resolve_session(sessions, target_name)
    if session is None:
        die(f"nenhuma sessão encontrada casando com '{target_name}'. "
            "Use 'sf list' para ver os nomes/ids ativos.")

    session_id = session["id"]
    name = session.get("tmux_name") or session.get("display_name") or session_id
    status, body = _upload_file(
        f"{base}/sessions/{session_id}/shared-files", token, path
    )
    if status != 201:
        die(f"upload falhou (HTTP {status}): {body}")

    size_kb = body.get("size", 0) / 1024
    print(f"compartilhado ✅ -> [{name}] {body.get('filename')} ({size_kb:.1f}KB)")
    print("  disponível no app (botão de arquivos na tela da sessão), inclusive fora do Mac.")


# --------------------------------------------------------------------------- #
# CLI
# --------------------------------------------------------------------------- #
def build_parser():
    p = argparse.ArgumentParser(
        prog="sf",
        description="Delega tarefas pesadas a workers filhos do SessionFlow "
                    "em outros provedores e colhe só o resultado (handoff).",
    )
    sub = p.add_subparsers(dest="command", required=True)

    d = sub.add_parser(
        "delegate",
        help="cria um worker filho (outro provedor), manda a tarefa e ele "
             "escreve o resultado num arquivo de handoff.",
        description="Ideia: use um provedor MAIS BARATO e um MODELO "
                    "INTERMEDIÁRIO (--model) para economizar token. O filho "
                    "roda autônomo (yolo). NÃO acompanhe o stream; use "
                    "'sf check' de vez em quando e leia só o handoff.",
    )
    d.add_argument("--provider", required=True, choices=PROVIDERS,
                   help="provedor do worker filho.")
    d.add_argument("--model", default=None,
                   help="id do modelo (OMITA para usar o default do provedor; "
                        "prefira um modelo intermediário p/ economizar).")
    d.add_argument("--effort", default=None,
                   help="nível de esforço (low/medium/high; ignorado no gemini).")
    d.add_argument("--dir", default=None,
                   help="work_dir do filho (default: diretório atual).")
    d.add_argument("--task", required=True, help="texto da tarefa a delegar.")
    d.add_argument("--role", default=None,
                   help="papel: resolve persona global e overlay local por referência.")
    d.add_argument("--context-file", default=None,
                   help="JSON de referências/fatos/decisões; nunca transcript.")
    d.add_argument("--name", default=None,
                   help="nome do worker (default: slug da tarefa + sufixo).")
    d.add_argument("--host", default=None,
                   help="host de destino (host_id, nome, hostname, emoji ou trecho) "
                        "ou 'auto' (escolhe o mais livre com o provider e a pasta). "
                        "Remoto: --dir é caminho/nome NAQUELE host (veja 'sf dirs').")
    d.add_argument("--worktree", action="store_true",
                   help="(remoto) roda num worktree novo na branch sf/<nome>.")
    d.add_argument("--push", action="store_true",
                   help="(remoto) filho faz git push da branch; sem isso, devolve .patch.")
    _REMOTE_HELP = (
        "controla uma instância SessionFlow de OUTRO amigo/deploy em vez da "
        "local — credenciais em ~/.claude/secrets/sf-remotes.env "
        "(<ALIAS>_BASE_URL/_EMAIL/_PASSWORD), ex.: --remote heverton."
    )
    d.add_argument("--remote", default=None, help=_REMOTE_HELP)
    d.set_defaults(func=cmd_delegate)

    c = sub.add_parser(
        "check",
        help="mostra status/activity do worker e imprime o handoff se existir.",
    )
    c.add_argument("target", help="nome (tmux_name) ou id da sessão.")
    c.add_argument("--dir", default=None,
                   help="work_dir onde está o handoff (default: diretório atual).")
    c.add_argument("--remote", default=None, help=_REMOTE_HELP)
    c.add_argument("--summary", action="store_true",
                   help="imprime somente handoff JSON compacto validado.")
    c.set_defaults(func=cmd_check)

    r = sub.add_parser(
        "request-context",
        help="pede fato/path pontual ao orquestrador sem puxar transcript.",
    )
    r.add_argument("target", help="sessão do orquestrador (nome ou id).")
    r.add_argument("question", help="pergunta curta, específica.")
    r.add_argument("--remote", default=None, help=_REMOTE_HELP)
    r.set_defaults(func=cmd_request_context)

    mt = sub.add_parser(
        "metrics",
        help="mede bytes de manifests/handoffs locais; sem API ou transcript.",
    )
    mt.add_argument("--dir", default=None,
                    help="work_dir contendo .sessionflow/handoff (default: diretório atual).")
    mt.add_argument("--strict", action="store_true",
                    help="falha se orçamento exceder ou JSON/contrato for inválido.")
    mt.set_defaults(func=cmd_metrics)

    ds = sub.add_parser(
        "dirs",
        help="lista pastas indexadas de um host (use p/ escolher --dir remoto).",
    )
    ds.add_argument("--host", required=True,
                    help="host: host_id, nome, hostname, emoji ou trecho único.")
    ds.add_argument("term", nargs="?", default="", help="trecho do caminho/nome.")
    ds.add_argument("--limit", type=int, default=20, help="máx. de pastas (≤50).")
    ds.add_argument("--remote", default=None, help=_REMOTE_HELP)
    ds.set_defaults(func=cmd_dirs)

    l = sub.add_parser(
        "list",
        help="lista as sessões ativas (nome, agente, status, host, id) — "
             "use pra descobrir o alvo do 'sf send'.",
    )
    l.add_argument("--remote", default=None, help=_REMOTE_HELP)
    l.set_defaults(func=cmd_list)

    hs = sub.add_parser(
        "hosts",
        help="lista os workers/hosts ativos (online/offline, hostname, "
             "host_id, capabilities) — de onde se tira o --host do delegate.",
    )
    hs.add_argument("--remote", default=None, help=_REMOTE_HELP)
    hs.set_defaults(func=cmd_hosts)

    st = sub.add_parser(
        "start",
        help="liga/inicia uma máquina Colab ou worker remoto.",
    )
    st.add_argument("host", help="host: host_id, nome, hostname, emoji ou alias (ex: colab1-cpu, colab2-pro).")
    st.add_argument("--remote", default=None, help=_REMOTE_HELP)
    st.set_defaults(func=cmd_start)

    sp = sub.add_parser(
        "stop",
        help="desliga/para uma máquina Colab ou worker remoto.",
    )
    sp.add_argument("host", help="host: host_id, nome, hostname, emoji ou alias (ex: colab1-cpu, colab2-pro).")
    sp.add_argument("--remote", default=None, help=_REMOTE_HELP)
    sp.set_defaults(func=cmd_stop)

    m = sub.add_parser(
        "send",
        help="manda uma mensagem/instrução pro terminal de uma sessão JÁ "
             "EXISTENTE (irmã), sem precisar criar sessão nem descobrir a API.",
    )
    m.add_argument("target", help="nome (tmux_name/display_name) ou id da sessão-alvo.")
    m.add_argument("text", help="texto a enviar pro terminal da sessão-alvo.")
    m.add_argument("--no-enter", action="store_true",
                   help="não aperta Enter depois do texto (default: aperta).")
    m.add_argument("--remote", default=None, help=_REMOTE_HELP)
    m.set_defaults(func=cmd_send)

    mv = sub.add_parser(
        "move",
        help="move uma sessão claude já iniciada pra outro host, retomando a "
             "mesma conversa (exige repo commitado e com push na origem).",
    )
    mv.add_argument("target", help="nome (tmux_name/display_name) ou id da sessão.")
    mv.add_argument("--host", required=True,
                    help="host de destino (host_id, nome, hostname, emoji ou trecho) "
                         "ou 'auto' (o mais livre com claude e a pasta, fora o atual).")
    mv.add_argument("--remote", default=None, help=_REMOTE_HELP)
    mv.set_defaults(func=cmd_move)

    h = sub.add_parser(
        "share",
        help="sobe um arquivo do disco pra ficar disponível no app "
             "(inclusive celular) — ex: uma imagem/PDF que você acabou de gerar.",
    )
    h.add_argument("path", help="caminho do arquivo (aceita ~ e relativo).")
    h.add_argument("--to", default=None,
                   help="sessão-alvo (nome ou id). Default: a própria sessão "
                        "de onde o comando roda (detecta via $TMUX).")
    h.add_argument("--remote", default=None, help=_REMOTE_HELP)
    h.set_defaults(func=cmd_share)

    f = sub.add_parser(
        "fetch",
        help="lê 1 arquivo de OUTRO host via SessionFlow (sem precisar de "
             "sessão Claude rodando lá). Use pra puxar log/config/código de "
             "uma máquina específica. Aceita host_id, nome, hostname, "
             "emoji ou apelido (duck/deepin/mac/hetzner/colab1-cpu...).",
        description="P2P host-to-host via relay do backend SF: publica um "
                    "comando fs_fetch pro worker do host alvo, faz polling em "
                    "/commands/{id} e imprime o conteúdo. Até 1 MiB por "
                    "arquivo, read-only, só dentro de $HOME ou /tmp.",
    )
    f.add_argument("target_host", help="host alvo (alias/emoji/host_id).")
    f.add_argument("path", help="path ABSOLUTO do arquivo no host remoto.")
    f.add_argument("--out", default=None,
                   help="grava num arquivo local (sempre usado pra binário; "
                        "pra texto é opcional — sem --out vai pra stdout).")
    f.add_argument("--timeout", type=float, default=_FETCH_POLL_TIMEOUT,
                   help=f"timeout do polling (default {_FETCH_POLL_TIMEOUT:.0f}s).")
    f.add_argument("--remote", default=None, help=_REMOTE_HELP)
    f.set_defaults(func=cmd_fetch)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    args.func(args)


if __name__ == "__main__":
    main()
