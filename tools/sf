def _colab_info(w):
    label = f"{w.get('display_name') or ''} {w.get('hostname') or ''} {w.get('host_id') or ''}".lower()
    is_colab2 = "colab 2" in label or "colab2" in label or "02151543" in label
    authuser = "1" if is_colab2 else "0"
    is_gpu = "gpu" in label or "t4" in label or (w.get("hardware") or {}).get("gpu")
    alias = "colab2-pro" if (is_colab2 and is_gpu) else ("colab2-cpu" if is_colab2 else ("colab1-pro" if is_gpu else "colab1-cpu"))
    url = f"https://colab.research.google.com/drive/1MLzqvoeSg_JeMywj4HzvyRKTmssieZH5?authuser={authuser}"
    return {
        "is_colab": "colab" in label,
        "authuser": authuser,
        "is_gpu": bool(is_gpu),
        "alias": alias,
        "url": url,
    }


def cmd_start(args):
    """Inicia / liga uma máquina Colab ou worker remoto."""
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    workers = fetch_workers(base, token)
    host = resolve_host(workers, args.host, allow_offline=True)
