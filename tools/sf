def _request(method, url, token=None, body=None, timeout=30):
    data = None
    # UA de navegador de verdade: instâncias remotas atrás de Cloudflare
    # (ex.: a do Heverton) bloqueiam o UA padrão do urllib
    # ("Python-urllib/3.x") como bot — "Error 1010: browser_signature_banned".
    # A local (127.0.0.1) nunca passa por Cloudflare, então isso é inofensivo.
    headers = {"Accept": "application/json", "User-Agent": _BROWSER_UA}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    if token:
        headers["Authorization"] = f"Bearer {token}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8")
            status = resp.status
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", "replace")
        status = exc.code
    except urllib.error.URLError as exc:
        die(f"falha de conexão com a API ({url}): {exc.reason}. "
            "A stack do SessionFlow está de pé?")
    try:
        parsed = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        parsed = {"_raw": raw}
    return status, parsed


def _upload_file(url, token, filepath):
    """POST multipart/form-data com 1 arquivo (campo ``file``), stdlib pura.

    Monta o corpo manualmente (boundary + headers) — evita depender de
    `requests`/`urllib3`, mantendo o script sem dependências externas.
    """
    boundary = uuid.uuid4().hex
    filename = os.path.basename(filepath)
    content_type = mimetypes.guess_type(filename)[0] or "application/octet-stream"
    with open(filepath, "rb") as fh:
        file_bytes = fh.read()

    parts = []
    parts.append(f"--{boundary}\r\n".encode())
    parts.append(
        f'Content-Disposition: form-data; name="file"; filename="{filename}"\r\n'
        f"Content-Type: {content_type}\r\n\r\n".encode()
    )
    parts.append(file_bytes)
    parts.append(f"\r\n--{boundary}--\r\n".encode())
    body = b"".join(parts)

    headers = {
        "Accept": "application/json",
        "Content-Type": f"multipart/form-data; boundary={boundary}",
        "Authorization": f"Bearer {token}",
        "User-Agent": _BROWSER_UA,
    }
    req = urllib.request.Request(url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode("utf-8")
            status = resp.status
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", "replace")
        status = exc.code
    except urllib.error.URLError as exc:
        die(f"falha de conexão com a API ({url}): {exc.reason}. "
            "A stack do SessionFlow está de pé?")
    try:
        parsed = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        parsed = {"_raw": raw}
    return status, parsed


def _download(url, token, dest):
    """GET binário autenticado → grava em `dest` (stdlib pura)."""
    headers = {"Authorization": f"Bearer {token}", "User-Agent": _BROWSER_UA}
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            data = resp.read()
    except urllib.error.HTTPError as exc:
        die(f"download falhou (HTTP {exc.code}): {url}")
    except urllib.error.URLError as exc:
        die(f"falha de conexão com a API ({url}): {exc.reason}")
    Path(dest).write_bytes(data)


def login(env):
    base = api_base(env)
    email = env.get("SESSIONFLOW_EMAIL")
    password = env.get("SESSIONFLOW_PASSWORD")
    if not email or not password:
        die("SESSIONFLOW_EMAIL/SESSIONFLOW_PASSWORD ausentes no .env")
    status, body = _request(
        "POST", f"{base}/auth/login", body={"email": email, "password": password}
    )
    if status != 200 or "token" not in body:
        die(f"login falhou (HTTP {status}): {body}")
    return body["token"]


def list_sessions(env, token):
    base = api_base(env)
    status, body = _request("GET", f"{base}/sessions", token=token)
    if status != 200:
        die(f"GET /sessions falhou (HTTP {status}): {body}")
    return body.get("items", [])


def resolve_session(sessions, target):
    """Resolve `target` (id, tmux_name ou display_name) numa lista de sessões.

    Tenta match exato primeiro (id > tmux_name > display_name); se não achar,
    cai para substring case-insensitive em tmux_name/display_name — mas só
    aceita se o resultado for ÚNICO (ambíguo é erro, não chute).
    """
    for s in sessions:
        if s.get("id") == target:
            return s
    for s in sessions:
        if s.get("tmux_name") == target or s.get("display_name") == target:
            return s
    # Ponte de comando: apelido dado no `--name` (`sf command mac --name lab-mac`
    # cria a ponte com outro nome mas ela continua endereçável por "lab-mac").
    for s in sessions:
        if target in (s.get("aliases") or []):
            return s
    needle = target.lower()
    matches = [
        s for s in sessions
        if needle in (s.get("tmux_name") or "").lower()
        or needle in (s.get("display_name") or "").lower()
    ]
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        names = ", ".join(s.get("tmux_name") or s.get("id") for s in matches)
        die(f"'{target}' é ambíguo, casa com várias sessões: {names}")
    return None


def local_host_id(path=None):
    """host_id do worker DESTE host, ou None (arquivo ausente/vazio)."""
    try:
        return Path(path or HOST_ID_PATH).read_text(encoding="utf-8").strip() or None
    except OSError:
        return None


def _host_label(w):
    state = "online" if w.get("online") else ("ligando" if w.get("starting") else "offline")
    shown = w.get("display_name") or w.get("hostname") or "?"
    return f"{w.get('emoji') or ''} {shown} ({w.get('hostname') or '-'}) {w.get('host_id')} {state}".strip()


def resolve_host(workers, alias, allow_offline=False):
    """Resolve `--host`: host_id exato > nome/hostname/emoji exato > substring única.

    Ambíguo, desconhecido ou offline → ValueError (o chamador faz `die`).
    """
    local_id = local_host_id()
    alias_map = {
        "colab1-cpu": "c775ad00-58bb-44ae-9781-7e7e23b5404d",
        "colab1-pro": "c775ad00-58bb-44ae-9781-7e7e23b5404e",
        "colab2-cpu": "02151543-4ff8-44c2-b607-b1dfc8625066",
        "colab2-pro": "02151543-4ff8-44c2-b607-b1dfc8625067",
        "colab-worker": "c775ad00-58bb-44ae-9781-7e7e23b5404d",
        "colab-pro": "02151543-4ff8-44c2-b607-b1dfc8625067",
        "duck": "67122d03-0b03-4b80-9001-ba982603d0fb",
        "deepin": "83f9a08a-8f6a-4445-bb17-704b0f7baa2b",
        "hetzner": "9e29a449-4f77-4915-b50c-4b5c3c722565",
        "heztner": "9e29a449-4f77-4915-b50c-4b5c3c722565",
        # Kaggle: worker registra sozinho no 1º heartbeat; o alias existe antes
        # disso para `start` achar a máquina mesmo com ela offline.
        "kaggle": "d060d384-ca72-427c-b559-fddaafb0c9ca",
        "kaggle-gpu": "d060d384-ca72-427c-b559-fddaafb0c9ca",
    }
    if local_id:
        alias_map["local"] = local_id
        alias_map["me"] = local_id
    resolved_alias = alias_map.get(alias.lower(), alias)
    known = [w for w in workers if w.get("host_id")]
    match = next((w for w in known if w["host_id"] == resolved_alias), None)
    if match is None:
        needle = alias.casefold()
        fields = ("display_name", "hostname", "emoji")
        exact = [w for w in known if any((w.get(f) or "").casefold() == needle for f in fields)]
        candidates = exact or [
            w for w in known if any(needle in (w.get(f) or "").casefold() for f in fields)
        ]
        if len(candidates) > 1:
            raise ValueError(
                f"host '{alias}' ambíguo: " + "; ".join(_host_label(w) for w in candidates)
            )
        if not candidates:
            listing = "; ".join(_host_label(w) for w in known) or "(nenhum host)"
            raise ValueError(f"host '{alias}' não encontrado. Hosts: {listing}")
        match = candidates[0]
    if not allow_offline and not match.get("online"):
        raise ValueError(f"host {_host_label(match)} está offline; suba o worker dele antes")
    return match


