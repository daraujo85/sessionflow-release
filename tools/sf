    # Notifica API para registrar intenção de start
    _, body = _request("POST", f"{base}/workers/{host_id}/start", token=token)
    colab_url = body.get("colab_url") if isinstance(body, dict) else info["url"]

    # Abre a URL no navegador se estiver no macOS
    if sys.platform == "darwin" and colab_url:
        print(f"🔗 Abrindo notebook no Google Colab: {colab_url}")
        subprocess.run(["open", colab_url], check=False)
        print("💡 No Google Colab:")
