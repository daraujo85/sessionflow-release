def cmd_metrics(args):
    entries = read_metrics(os.path.abspath(args.dir or os.getcwd()))
    totals = {key: sum(item[key] for item in entries) for key in ("task_bytes", "context_bytes", "manifest_bytes", "handoff_bytes")}
    failed = False
    for item in entries:
        flags = ",".join(item["violations"]) or "-"
        print(
            f"{item['name']} role={item['role']} status={item['status']} "
            f"task_bytes={item['task_bytes']} context_bytes={item['context_bytes']} "
            f"manifest_bytes={item['manifest_bytes']} handoff_bytes={item['handoff_bytes']} flags={flags}"
        )
        failed |= bool(item["violations"]) or item["status"] == "invalid"
    print("total " + " ".join(f"{key}={value}" for key, value in totals.items()))
    if args.strict and failed:
        raise SystemExit(1)


