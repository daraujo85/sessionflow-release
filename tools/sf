def load_env(path=ENV_PATH):
    """Lê chaves simples KEY=VALUE de um .env (ignora comentários/linhas vazias)."""
    env = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                env[key.strip()] = val.strip()
    except FileNotFoundError:
        die(f"não encontrei o .env do SessionFlow em {path}")
    return env


def api_base(env):
    # Instância REMOTA (ver --remote / load_remote): já vem com a URL completa,
    # não com porta local — usa direto, sem montar 127.0.0.1.
    if env.get("API_BASE_URL"):
        return env["API_BASE_URL"].rstrip("/")
    port = env.get("API_HOST_PORT", "8000")
    return f"http://127.0.0.1:{port}"


REMOTES_ENV_PATH = os.path.expanduser("~/.claude/secrets/sf-remotes.env")


def load_remote(alias):
    """Credenciais de uma instância SessionFlow REMOTA (outro amigo/deploy),
    fora do git (``~/.claude/secrets/sf-remotes.env``).

    Formato: ``<ALIAS>_BASE_URL``/``<ALIAS>_EMAIL``/``<ALIAS>_PASSWORD``
    (alias em maiúsculas), ex.::

        HEVERTON_BASE_URL=https://api-sessionflow.anthonygabriel.com.br
        HEVERTON_EMAIL=heverton@...
        HEVERTON_PASSWORD=...

    Devolve um dict no mesmo formato de :func:`load_env` (compatível com
    :func:`login`/:func:`api_base`) — assim o resto do script nem sabe que é
    remoto.
    """
    remotes = load_env(REMOTES_ENV_PATH)
    prefix = alias.strip().upper()
    base_url = remotes.get(f"{prefix}_BASE_URL")
    email = remotes.get(f"{prefix}_EMAIL")
    password = remotes.get(f"{prefix}_PASSWORD")
    if not (base_url and email and password):
        die(
            f"remote '{alias}' incompleto/ausente em {REMOTES_ENV_PATH} "
            f"(esperado {prefix}_BASE_URL / {prefix}_EMAIL / {prefix}_PASSWORD)"
        )
    return {
        "API_BASE_URL": base_url,
        "SESSIONFLOW_EMAIL": email,
        "SESSIONFLOW_PASSWORD": password,
    }


def resolve_env(args):
    """``load_remote(args.remote)`` se ``--remote`` foi passado, senão o
    ``.env`` local de sempre — ponto único usado por todo comando."""
    remote = getattr(args, "remote", None)
    return load_remote(remote) if remote else load_env()


def detect_parent():
    """tmux_name da PRÓPRIA sessão chefe (quem está delegando), ou None.

    Só resolve quando rodando DENTRO de um tmux (``$TMUX`` setado): usa
    ``tmux display-message -p '#S'`` p/ pegar o nome da sessão atual. Fora do
    tmux (ou se o comando falhar) devolve None — o filho fica sem pai.
    """
    if not os.environ.get("TMUX"):
        return None
    try:
        import subprocess

        out = subprocess.run(
            ["tmux", "display-message", "-p", "#S"],
            capture_output=True, text=True, timeout=5,
        )
        name = (out.stdout or "").strip()
        return name or None
    except Exception:  # noqa: BLE001 - best-effort; sem pai não é erro
        return None


