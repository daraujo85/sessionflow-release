def cmd_hosts(args):
    """Lista os workers/hosts do SessionFlow (multi-host, AD-011).

    Mostra online/offline, hostname, display_name, emoji, host_id e
    capabilities — é de onde se tira o `--host <host_id|nome|emoji>` do
    `sf delegate`. O `--host` também aceita nome/hostname/emoji (resolve
    via `resolve_host`); este comando só lista pra você saber o que existe.
    """
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    workers = fetch_workers(base, token)
    if not workers:
        print("(nenhum worker registrado)")
        return
    for w in workers:
        online = "🟢" if w.get("online") else ("🟡" if w.get("starting") else "🔴")
        label = _host_label(w)
        host_id = w.get("host_id") or "-"
        caps = (w.get("capabilities") or {})
        cap_txt = ",".join(k for k, v in caps.items() if v) if isinstance(caps, dict) else ""
        line = f"{online} {label}\thost_id={host_id}\tcaps={cap_txt or '-'}"
        m = w.get("metrics") or {}
        if m.get("cpu_pct") is not None and m.get("mem_avail_gb") is not None:
            cpu = m["cpu_pct"]
            total = m.get("mem_total_gb") or 0.1
            used_ram = max(0, total - m["mem_avail_gb"])
            ram_pct = (used_ram / total) * 100 if total > 1 else 0

            line += f"\tcpu {_progress_bar(cpu)} {cpu:.0f}%"
            total_txt = f"/{total:.1f}G" if m.get("mem_total_gb") else "G"
            line += f"  ram {_progress_bar(ram_pct)} {used_ram:.1f}{total_txt} uso ({m['mem_avail_gb']:.1f}G livre)"

        hw = w.get("hardware") or {}  # worker antigo publica hardware=null
        disks = hw.get("disks") or []
        if disks:
            # Pega o disco raiz, ou o maior
            main_disk = next((d for d in disks if d.get("mount") == "/"), sorted(disks, key=lambda d: d.get("total_gb", 0), reverse=True)[0])
            disk_total = main_disk.get("total_gb", 0.1)
            disk_used = main_disk.get("used_gb", 0)
            disk_pct = (disk_used / disk_total) * 100 if disk_total > 1 else 0
            line += f"  disk {_progress_bar(disk_pct)} {disk_used:.0f}/{disk_total:.0f}G"

        gpu_name = hw.get("gpu")
        if gpu_name:
            line += f"  gpu [{gpu_name}]"
            vram_total = m.get("vram_total_gb")
            vram_used = m.get("vram_used_gb")
            if vram_total is not None and vram_used is not None:
                vram_pct = (vram_used / vram_total) * 100 if vram_total > 0 else 0
                line += f" vram {_progress_bar(vram_pct)} {vram_used:.1f}/{vram_total:.1f}G"

        agents = [k for k, v in (w.get("agents") or {}).items() if v]
        if agents:
            line += f"\tagents={','.join(agents)}"
        print(line)


