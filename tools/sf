AUTO_MAX_CPU = float(os.environ.get("SF_AUTO_MAX_CPU", 85.0))      # acima disso o host é considerado ocupado
AUTO_MIN_MEM_GB = float(os.environ.get("SF_AUTO_MIN_MEM_GB", 2.0)) # RAM disponível mínima p/ subir um agent
AUTO_TIE_PCT = 0.05      # scores a ≤5% do maior empatam → prefere o local


AUTO_DEFAULT_CORES = 4   # worker antigo sem hardware.cpu_cores
AUTO_GPU_BONUS = 1.2     # GPU dedicada pesa como +20% de poder

# Hosts PRIORITÁRIOS (tentados primeiro, em ordem, antes do ranking por score).
# Se o host estiver online, passar nos filtros (CPU/RAM/agent/dir) e não estar
# ocupado → é escolhido independente do score. Só cai no ranking padrão se
# TODOS os hosts prioritários falharem (offline, ocupado, sem o provider, etc).
# Google Colab: crédito Google → usar enquanto online e livre, antes dos outros.
# Colab Pro (Tesla T4 + claude) acima da free: GPU disponível pra Whisper/tremio.
AUTO_PRIORITY_HOSTS = [
    "02151543-4ff8-44c2-b607-b1dfc8625067",  # ⚡ Colab 2 Pro (GPU T4, 19db473d4190)
    "c775ad00-58bb-44ae-9781-7e7e23b5404e",  # ⚡ Colab 1 Pro (GPU T4, colab1-pro)
    "02151543-4ff8-44c2-b607-b1dfc8625066",  # 🐴 Colab 2 (CPU, colab2-cpu)
    "c775ad00-58bb-44ae-9781-7e7e23b5404d",  # 🐴 Colab 1 (CPU, 4f5458b8bf9c)
]


def host_score(w):
    """Poder de processamento LIVRE: núcleos ociosos × RAM disponível (√ p/
    a RAM não dominar), com bônus de GPU. Máquina mais forte E mais livre
    vence — 16 núcleos a 40% ganham de 2 núcleos ociosos."""
    m = w["metrics"]
    hw = w.get("hardware") or {}
    cores = hw.get("cpu_cores") or AUTO_DEFAULT_CORES
    free_cores = cores * (1 - m["cpu_pct"] / 100)
    score = free_cores * m["mem_avail_gb"] ** 0.5
    if hw.get("gpu"):
        score *= AUTO_GPU_BONUS
    return score


def pick_host(workers, provider, local_id, dir_ok, need_remote=False):
    """Escolhe o host p/ `--host auto`. Pura: rede só via `dir_ok` (injetado).

    Filtros baratos primeiro (online, métricas, agent, piso); `dir_ok(w)` —
    que pode consultar a API — só roda nos sobreviventes, em ordem de score.
    Hosts em AUTO_PRIORITY_HOSTS são tentados PRIMEIRO (em ordem), antes do
    ranking por score. Se todos os prioritários falharem (offline/ocupado/sem
    provider), o ranking normal por CPU+RAM toma conta.
    Retorna (escolhido|None, aprovados ordenados, [(host, motivo)], local_serve).
    """
    def _passes_filters(w):
        """None = passou; str = motivo de rejeição."""
        m = w.get("metrics") or {}
        cpu, mem = m.get("cpu_pct"), m.get("mem_avail_gb")
        if not w.get("online"):
            return "offline"
        if need_remote and w.get("host_id") == local_id:
            return "--worktree/--push exigem host remoto"
        if cpu is None or mem is None:
            return "sem métricas (worker desatualizado?)"
        if not (w.get("agents") or {}).get(provider):
            return f"{provider} não instalado"
        if cpu > AUTO_MAX_CPU:
            return f"cpu {cpu:.0f}% > {AUTO_MAX_CPU:.0f}%"
        if mem < AUTO_MIN_MEM_GB:
            return f"ram livre {mem:.1f}G < {AUTO_MIN_MEM_GB:.0f}G"
        return None

    rejected, pool = [], []
    by_id = {w["host_id"]: w for w in workers}

    # --- Fase 1: hosts prioritários (ex.: Google Colab) --------------------- #
    priority_tried = set()
    for pid in AUTO_PRIORITY_HOSTS:
        w = by_id.get(pid)
        if w is None:
            continue
        priority_tried.add(pid)
        reason = _passes_filters(w)
        if reason:
            rejected.append((w, f"prioritário descartado: {reason}"))
            continue
        dir_reason = dir_ok(w)
        if dir_reason:
            rejected.append((w, f"prioritário descartado: {dir_reason}"))
            continue
        # Passou tudo → escolhido direto, sem precisar avaliar os outros
        label = w.get("display_name") or w.get("hostname") or pid[:8]
        print(f"host auto → {label} (prioritário, {pid[:8]}…) cpu {(w.get('metrics') or {}).get('cpu_pct', '?'):.0f}% ram {(w.get('metrics') or {}).get('mem_avail_gb', '?'):.1f}G livre")
        return w, [w], rejected, True

    # --- Fase 2: ranking por score (comportamento original) ----------------- #
    for w in workers:
        if w["host_id"] in priority_tried:
            continue  # já avaliado acima, motivo já em rejected
        reason = _passes_filters(w)
        if reason:
            rejected.append((w, reason))
        else:
            pool.append(w)

    ranked = []
    for w in sorted(pool, key=host_score, reverse=True):
        reason = dir_ok(w)
        if reason:
            rejected.append((w, reason))
        else:
            ranked.append(w)
    if not ranked:
        # Nenhum remoto serve. Sinaliza se o LOCAL também não aguenta —
        # quem chama decide entre fallback silencioso e abortar com erro.
        local_worker = next((w for w in workers if w.get("host_id") == local_id), None)
        return None, [], rejected, _local_serves(local_worker)
    best = host_score(ranked[0])
    local = next((w for w in ranked if w.get("host_id") == local_id), None)
    if local and best - host_score(local) <= best * AUTO_TIE_PCT:
        ranked.remove(local)
        ranked.insert(0, local)
    return ranked[0], ranked, rejected, True


def _local_serves(local_worker):
    """True se o host local tem métricas que sustentam um agent sem crashar.

    O fallback de ``--host auto`` (quando nenhum remoto serve) usa o LOCAL,
    mas só faz sentido se o local aguenta — caso contrário a sessão sobe e o
    worker mata ela em segundos por OOM/cpu pegada. Quem chama decide:
    recebe o bool no 4º elemento da tupla do ``pick_host``.
    """
    if not local_worker or not local_worker.get("online"):
        return False
    m = local_worker.get("metrics") or {}
    cpu, mem = m.get("cpu_pct"), m.get("mem_avail_gb")
    if cpu is None or mem is None:
        return False
    if cpu > AUTO_MAX_CPU:
        return False
    if mem < AUTO_MIN_MEM_GB:
        return False
    return True


def auto_dir_checker(base, token, local_id, dir_arg):
    """`dir_ok` p/ pick_host + mapa host_id→alvo resolvido (path/is_git).

    Local: `--dir` (ou cwd) tem que existir aqui. Remoto: procura o NOME da
    pasta (basename) no índice do host; exige 1 match exato por nome.
    Falha de rede num host vira motivo de descarte, não aborta o auto.
    """
    local_path = os.path.abspath(dir_arg or os.getcwd())
    name = os.path.basename(local_path.rstrip("/"))
    targets = {}

    def dir_ok(w):
        hid = w["host_id"]
        if hid == local_id:
            if not os.path.isdir(local_path):
                return f"pasta {local_path} não existe aqui"
            targets[hid] = {"path": local_path, "is_git": None}
            return None
        try:
            items = fetch_dirs(base, token, hid, name, 50)
        except SystemExit:
            return "erro ao listar pastas do host"
        exact = [d for d in items if d.get("name") == name]
        if not exact:
            return f"pasta '{name}' não indexada"
        if len(exact) > 1:
            return f"pasta '{name}' ambígua ({len(exact)} matches)"
        targets[hid] = {"path": exact[0]["path"], "is_git": exact[0].get("is_git")}
        return None

    return dir_ok, targets


def _progress_bar(pct, width=10):
    """Retorna uma string visual de barra de progresso, ex: [██████    ]."""
    if pct is None:
        return f"[{'?' * width}]"
    pct = max(0.0, min(100.0, float(pct)))
    filled = int(round((pct / 100.0) * width))
    return f"[{'█' * filled}{' ' * (width - filled)}]"

def _auto_summary(chosen, rejected):
    """Linhas de saída do auto: escolhido (score/cpu/ram) + descartados."""
    lines = []
    if chosen:
        m = chosen["metrics"]
        shown = f"{chosen.get('emoji') or ''} {chosen.get('display_name') or chosen.get('hostname')}".strip()
        lines.append(f"host auto → {shown} ({chosen['host_id'][:8]}…) score {host_score(chosen):.1f}"
                     f" | cpu {m['cpu_pct']:.0f}% | ram livre {m['mem_avail_gb']:.1f}G")
    if rejected:
        lines.append("  descartados: " + "; ".join(
            f"{w.get('emoji') or ''} {w.get('display_name') or w.get('hostname')} ({r})".strip()
            for w, r in rejected))
    return lines


def fetch_workers(base, token):
    status, body = _request("GET", f"{base}/workers", token=token)
    if status != 200 or not isinstance(body, list):
        die(f"GET /workers falhou (HTTP {status}): {body}")
    return body


def fetch_dirs(base, token, host_id, q, limit):
    qs = urllib.parse.urlencode({"host_id": host_id, "q": q, "limit": min(limit, 50)})
    status, body = _request("GET", f"{base}/directories?{qs}", token=token)
    if status != 200:
        die(f"GET /directories falhou (HTTP {status}): {body}")
    return body.get("items", [])


