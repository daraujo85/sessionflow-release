            f"task_bytes={item['task_bytes']} context_bytes={item['context_bytes']} "
            f"manifest_bytes={item['manifest_bytes']} handoff_bytes={item['handoff_bytes']} flags={flags}"
        )
        failed |= bool(item["violations"]) or item["status"] == "invalid"
    print("total " + " ".join(f"{key}={value}" for key, value in totals.items()))
    if args.strict and failed:
        raise SystemExit(1)


