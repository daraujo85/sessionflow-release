def pick_remote_files(items, name):
    """Artefatos de handoff de `name`, 1 por arquivo, o mais recente (API: desc).

    Só nomes exatos do contrato → o filename nunca vira path traversal local.
    """
    wanted = {f"{name}.md", f"{name}.handoff.json", f"{name}.patch"}
    seen, picked = set(), []
    for item in items:
        filename = item.get("filename")
        if filename in wanted and filename not in seen:
            seen.add(filename)
            picked.append(item)
    return picked


def pull_remote_handoff(env, token, reg):
    """Baixa os artefatos do filho remoto p/ o handoff local; devolve paths salvos."""
    base = api_base(env)
    status, body = _request("GET", f"{base}/sessions/{reg['id']}/shared-files", token=token)
    if status != 200:
        print(f"aviso: não consegui listar shared-files (HTTP {status})", file=sys.stderr)
        return []
    dest_dir = handoff_dir(reg["dir"])
    os.makedirs(dest_dir, exist_ok=True)
    saved = []
    for item in pick_remote_files(body.get("items", []), reg["name"]):
        dest = os.path.join(dest_dir, item["filename"])
        _download(f"{base}/shared-files/{item['id']}/download", token, dest)
        saved.append(dest)
    return saved


def cmd_check(args):
    target = args.target
    work_dir = os.path.abspath(args.dir or os.getcwd())

    # Tenta achar o registro local (por nome) pra saber dir/nome do handoff.
    # --dir pode ser o path REMOTO do filho (não existe aqui); o registro vive
    # no cwd de quem delegou → cai pro cwd se não achar em --dir.
    reg = None
    for base_dir in dict.fromkeys((work_dir, os.getcwd())):
        for reg_file in (registry_path(base_dir, target),
                         legacy_registry_path(base_dir, target)):
            if not os.path.exists(reg_file):
                continue
            try:
                with open(reg_file, "r", encoding="utf-8") as fh:
                    reg = json.load(fh)
            except (OSError, json.JSONDecodeError):
                reg = None
            break
        if reg:
            break

    env = resolve_env(args)
    token = login(env)
    sessions = list_sessions(env, token)

    session = None
    for s in sessions:
        if s.get("id") == target or s.get("tmux_name") == target \
                or s.get("display_name") == target:
            session = s
            break

    name = (reg or {}).get("name") or (session or {}).get("tmux_name") or target
    hdir = (reg or {}).get("dir") or work_dir

    # Sem registro (delegado de outro dir/sessão), mas a sessão roda em OUTRO
    # host: o handoff só existe via shared-files → baixa pro cwd local.
    if reg is None and session is not None:
        sess_host = session.get("host_id")
        if sess_host and sess_host != local_host_id():
            hdir = os.getcwd()
            reg = {"id": session["id"], "name": name, "remote": True, "dir": hdir}

    patch_file = None
    if reg and reg.get("remote"):
        saved = pull_remote_handoff(env, token, reg)
        patch_file = next((p for p in saved if p.endswith(".patch")), None)

    if session is not None:
        status = session.get("status") or "?"
        activity = session.get("activity") or "-"
        prov = session.get("agent_type") or (reg or {}).get("provider") or "?"
        print(f"[{name}] {prov} | status={status} | activity={activity}")
    else:
        print(f"[{name}] sessão não encontrada na lista "
              "(pode ter sido encerrada/purgada)")

    # dica do patch ANTES da validação JSON
    if patch_file:
        patch_size = os.path.getsize(patch_file) if os.path.exists(patch_file) else 0
        if patch_size == 0:
            print("patch vazio (filho não commitou mudanças)")
        else:
            print(f"patch: {patch_file}  (aplique com: git am {patch_file})")

    json_path = handoff_json_path(hdir, name)
    if os.path.exists(json_path):
        try:
            handoff = validate_handoff(json.loads(Path(json_path).read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError, ValueError) as exc:
            print(f"handoff JSON inválido: {exc}")
            return
        if args.summary:
            print(f"status={handoff['status']}")
            print(f"summary={handoff['summary']}")
            for key in ("diff", "tests", "blockers", "questions"):
                print(f"{key}={'; '.join(handoff[key]) or '-'}")
            return
    elif args.summary:
        print("ainda rodando (sem handoff JSON ainda)")
        return

    md_path = handoff_md_path(hdir, name)
    if os.path.exists(md_path):
        print(f"--- handoff ({md_path}) ---")
        try:
            sys.stdout.write(Path(md_path).read_text(encoding="utf-8"))
            sys.stdout.write("\n")
        except OSError as exc:
            print(f"(não consegui ler o handoff: {exc})")
    else:
        print("ainda rodando (sem handoff ainda)")


