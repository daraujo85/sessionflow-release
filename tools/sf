# comando: share
# --------------------------------------------------------------------------- #
def cmd_share(args):
    """Sobe um arquivo do disco pra ficar disponível no app (inclusive celular).

    Resolve a sessão de destino em duas etapas: `--to <alvo>` explícito, ou
    (default) a PRÓPRIA sessão de onde o comando roda (via `detect_parent()`,
    que lê `$TMUX`) — o caso de uso comum é o agente compartilhar um arquivo
    que ele mesmo acabou de gerar, na sessão em que já está.
    """
    path = os.path.abspath(os.path.expanduser(args.path))
    if not os.path.isfile(path):
        die(f"arquivo não encontrado: {path}")

    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    sessions = list_sessions(env, token)

    target_name = args.to or detect_parent()
    if not target_name:
        cwd = os.path.realpath(os.getcwd())
        for s in sessions:
            swd = os.path.realpath(s.get("work_dir") or "")
            if swd and swd != "/" and (cwd == swd or cwd.startswith(swd + "/") or swd.startswith(cwd + "/")):
                target_name = s.get("tmux_name") or s.get("id")
                break
    if not target_name:
        die("não rodando dentro de um tmux do SessionFlow e nenhum --to informado; "
            "especifique a sessão com --to <nome-ou-id>")

    session = resolve_session(sessions, target_name)
    if session is None:
        die(f"nenhuma sessão encontrada casando com '{target_name}'. "
            "Use 'sf list' para ver os nomes/ids ativos.")

    session_id = session["id"]
    name = session.get("tmux_name") or session.get("display_name") or session_id
    status, body = _upload_file(
        f"{base}/sessions/{session_id}/shared-files", token, path
    )
    if status != 201:
        die(f"upload falhou (HTTP {status}): {body}")

    size_kb = body.get("size", 0) / 1024
    print(f"compartilhado ✅ -> [{name}] {body.get('filename')} ({size_kb:.1f}KB)")
    print("  disponível no app (botão de arquivos na tela da sessão), inclusive fora do Mac.")


