# Opções do verbo `command` que CONSOMEM valor (as outras são flags). A lista
# é conferida por teste contra o parser — se alguém adicionar opção nova com
# valor, o teste quebra e a lista é atualizada.
_CMD_VALUE_OPTS = frozenset(
    {"--name", "--dir", "--timeout", "--tail-lines", "--remote"}
)


def _split_command_argv(argv):
    """Separa o TEXTO do comando do resto da linha ``sf command ...``.

    Por que: ``host`` é positional e ``command`` é positional ``nargs="?"``.
    Quando a opção vem ANTES do texto (``sf command mac --name lab "ls"``), o
    argparse entrega o VALOR da opção ("lab") pro slot ``command`` e joga o
    texto real em "unrecognized arguments" — nenhuma forma de ``nargs``
    resolve (testado: ``?``, ``*``, ``REMAINDER``). Extraindo o texto ANTES do
    argparse, as duas ordens funcionam.
    """
    argv = list(argv or [])
    if not argv or argv[0] != "command":
        return argv, None
    rest = argv[1:]
    free = []       # (índice, token) de tudo que NÃO é opção nem valor de opção
    i = 0
    while i < len(rest):
        tok = rest[i]
        if tok in ("-h", "--help"):
            break
        if tok.startswith("-") and tok != "-":
            i += 2 if tok in _CMD_VALUE_OPTS else 1
            continue
        free.append((i, tok))
        i += 1
    if len(free) < 2:
        return argv, None
    idx, text = free[1]          # free[0] = host, free[1] = texto do comando
    return ["command"] + rest[:idx] + rest[idx + 1:], text


def main(argv=None):
    parser = build_parser()
    argv = list(sys.argv[1:] if argv is None else argv)
    argv, cmd_text = _split_command_argv(argv)
    args = parser.parse_args(argv)
    if cmd_text is not None:
        args.command = cmd_text
    args.func(args)


if __name__ == "__main__":
    main()
