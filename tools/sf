_FETCH_POLL_TIMEOUT = 30.0
_FETCH_POLL_INTERVAL = 0.25


def _resolve_remote_host_id(args):
    """Resolve alias/emoji/host_id pra um host_id REAL, usando ``sf hosts``.

    Falha se o host não estiver cadastrado (worker nunca fez heartbeat) ou
    se o alias for ambíguo. Aceita ``--remote`` igual aos outros comandos —
    roteia contra uma instância SF de outro amigo/deploy.
    """
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    status, body = _request("GET", f"{base}/workers", token=token, timeout=15)
    if status != 200:
        die(f"GET /workers falhou (HTTP {status}): {body}")
    workers = body if isinstance(body, list) else []
    try:
        host = resolve_host(workers, args.target_host, allow_offline=False)
    except ValueError as exc:
        die(str(exc))
    return host["host_id"]


def cmd_fetch(args):
    """Lê 1 arquivo de OUTRO host via SessionFlow (sem precisar de sessão).

    Publica um comando ``fs_fetch`` na fila do worker do host alvo via API;
    o worker grava o resultado em ``command_results``; este CLI faz polling
    em ``GET /commands/{command_id}`` e imprime o conteúdo.

    Saída:
      - arquivo texto → imprime direto na stdout
      - arquivo binário OU ``--out`` → escreve no destino (decodifica base64)
      - erro → exit code 2 com mensagem
    """
    host_id = _resolve_remote_host_id(args)
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)

    status, body = _request(
        "POST",
        f"{base}/hosts/{host_id}/fetch",
        token=token,
        body={"path": args.path},
        timeout=15,
    )
    if status != 202 or "command_id" not in body:
        die(f"fetch enfileirar falhou (HTTP {status}): {body}")
    command_id = body["command_id"]

    timeout = getattr(args, "timeout", None) or _FETCH_POLL_TIMEOUT
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        time.sleep(_FETCH_POLL_INTERVAL)
        status, body = _request(
            "GET", f"{base}/commands/{command_id}", token=token, timeout=10,
        )
        if status != 200:
            die(f"polling /commands falhou (HTTP {status}): {body}")
        st = body.get("status")
        if st == "ok":
            _emit_fetch_result(host_id, body.get("result") or {}, args)
            return
        if st == "error":
            err = body.get("error") or "erro desconhecido"
            die(f"fetch em {host_id} falhou: {err}", code=2)
        # status == "pending" → continua polling
    die(f"timeout aguardando fetch em {host_id} ({timeout:.0f}s)", code=2)


def _emit_fetch_result(host_id: str, result: dict, args) -> None:
    """Imprime texto na stdout OU grava binário em ``--out`` / base64 em stdout."""
    out_path = getattr(args, "out", None)
    truncated = result.get("truncated", False)
    returned = result.get("returned_bytes", 0)
    total = result.get("size_bytes", returned)
    binary = result.get("binary", False)

    if binary or out_path:
        # binário OU --out: sempre grava arquivo. Sem --out usa /tmp/<cmd>-<id>.
        import base64 as _b64
        import uuid as _uuid
        if binary:
            payload = _b64.b64decode(result.get("content_b64", ""))
        else:
            payload = result.get("text", "").encode("utf-8")
        target = out_path or f"/tmp/sf-fetch-{_uuid.uuid4().hex[:8]}"
        Path(target).write_bytes(payload)
        kind = "binário" if binary else "texto→arquivo"
        print(
            f"fetch ✅ <{host_id}> {result.get('path')} "
            f"({returned}/{total} bytes, {kind}) → {target}"
        )
        if truncated:
            print(f"  ⚠️  truncado em {returned} bytes (limite 1 MiB)")
        return

    # texto sem --out: imprime direto
    text = result.get("text", "")
    sys.stdout.write(text)
    if not text.endswith("\n"):
        sys.stdout.write("\n")
    print(
        f"-- ({returned}/{total} bytes de {result.get('path')} em {host_id})",
        file=sys.stderr,
    )
    if truncated:
        print("  ⚠️  truncado em 1 MiB", file=sys.stderr)


# --------------------------------------------------------------------------- #
# comando: gpu (serviços de GPU sob demanda)
# --------------------------------------------------------------------------- #
#: Timeout do polling do comando ``gpu_service``. Subir um modelo na GPU leva
#: dezenas de segundos (o auto-start espera o health check), então a janela
#: é generosa — mas não infinita.
_GPU_POLL_TIMEOUT = 120.0
_GPU_POLL_INTERVAL = 0.5


def cmd_gpu(args):
    """Liga/desliga/consulta os serviços de GPU (xtts, omnivoice, ...) de um host.

    Publica o comando ``gpu_service`` na fila do worker do host alvo via API
    (mesmo mecanismo do ``fetch``); o worker executa o ``systemctl`` e grava
    o resultado em ``command_results``; este CLI faz polling em
    ``GET /commands/{command_id}`` e imprime o estado.

    A visão de TODOS os serviços sai do heartbeat (``worker_status.gpu_services``)
    — é instantânea e não acorda nada; o status de UM serviço vai como comando
    (estado real do systemd).
    """
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    workers = fetch_workers(base, token)
    try:
        host = resolve_host(workers, args.host, allow_offline=False)
    except ValueError as exc:
        die(str(exc))
    host_id = host["host_id"]
    action = args.action
    name = (args.name or "").strip()

    if action == "status" and not name:
        _print_gpu_snapshot(host)
        return
    if not name:
        die(f"'{action}' precisa do nome do serviço "
            f"(ex.: sf gpu {args.host} {action} xtts)")

    result = _gpu_command(base, token, host_id, action, name)
    _print_gpu_result(action, name, result)


def _gpu_command(base, token, host_id, action, name):
    """Publica o comando e espera o resultado (polling em /commands/{id})."""
    status, body = _request(
        "POST",
        f"{base}/hosts/{host_id}/gpu-services/{name}/{action}",
        token=token,
        body={},
        timeout=15,
    )
    if status != 202 or "command_id" not in body:
        die(f"gpu {action} enfileirar falhou (HTTP {status}): {body}")
    command_id = body["command_id"]

    deadline = time.monotonic() + _GPU_POLL_TIMEOUT
    while time.monotonic() < deadline:
        time.sleep(_GPU_POLL_INTERVAL)
        status, body = _request(
            "GET", f"{base}/commands/{command_id}", token=token, timeout=10,
        )
        if status != 200:
            die(f"polling /commands falhou (HTTP {status}): {body}")
        st = body.get("status")
        if st == "ok":
            return body.get("result") or {}
        if st == "error":
            err = body.get("error") or "erro desconhecido"
            die(f"gpu {action} {name} em {host_id} falhou: {err}", code=2)
        # status == "pending" → continua polling
    die(f"timeout aguardando gpu {action} em {host_id}", code=2)


def _print_gpu_snapshot(host):
    """Imprime o estado de TODOS os serviços (vem do heartbeat do worker)."""
    services = host.get("gpu_services") or {}
    if not services:
        print("(nenhum serviço de GPU configurado neste host)")
        return
    for name, info in sorted(services.items()):
        info = info or {}
        active = "🟢" if info.get("active") else "⚪"
        last = info.get("last_used_at") or "-"
        unit = info.get("unit") or "-"
        print(f"{active} {name}\tactive={info.get('active')}\tunit={unit}\tlast_used_at={last}")


def _print_gpu_result(action, name, result):
    """Imprime o resultado de um comando gpu_service (start/stop/status)."""
    if not result:
        print(f"gpu {action} {name}: (sem resultado)")
        return
    if result.get("services"):
        for svc_name, info in sorted(result["services"].items()):
            info = info or {}
            active = "🟢" if info.get("active") else "⚪"
            print(f"{active} {svc_name}\tactive={info.get('active')}\t"
                  f"unit={info.get('unit') or '-'}\t"
                  f"last_used_at={info.get('last_used_at') or '-'}")
        return
    active = "🟢" if result.get("active") else "⚪"
    print(f"{active} {result.get('name') or name}\taction={result.get('action') or action}\t"
          f"active={result.get('active')}\tunit={result.get('unit') or '-'}")


