MOVE_TIMEOUT_SECONDS = 180
MOVE_POLL_SECONDS = 3


def _short_host(w):
    return f"{w.get('emoji') or ''} {w.get('display_name') or w.get('hostname') or w.get('host_id')}".strip()


def cmd_move(args):
    """Move uma sessão claude JÁ iniciada pra outro host, retomando a conversa.

    `POST /sessions/{id}/move` e polling do doc até `moving` sumir com o
    `host_id` do destino (sucesso) ou `moving.phase == "failed"` (erro).
    """
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)

    session = resolve_session(list_sessions(env, token), args.target)
    if session is None:
        die(f"nenhuma sessão encontrada casando com '{args.target}'. "
            "Use 'sf list' para ver os nomes/ids ativos.")
    session_id = session["id"]
    current = session.get("host_id")

    workers = fetch_workers(base, token)
    if args.host.lower() == "auto":
        # Mesmo ranking do delegate, sem o host atual; a pasta (basename do
        # work_dir) tem que estar indexada no destino — mesma regra da API.
        dir_ok, _ = auto_dir_checker(base, token, None, session.get("work_dir") or "")
        chosen, _, rejected, _ = pick_host([w for w in workers if w.get("host_id") != current],
                                            "claude", local_host_id(), dir_ok)
        summary = _auto_summary(chosen, rejected)
        if chosen is None:
            die("--host auto: nenhum host serve. " + " ".join(summary))
        print("\n".join(summary))
        host = chosen
    else:
        try:
            host = resolve_host(workers, args.host)
        except ValueError as exc:
            die(str(exc))
    target = host["host_id"]

    status, body = _request("POST", f"{base}/sessions/{session_id}/move",
                            token=token, body={"target_host_id": target})
    if status != 202:
        detail = body.get("detail") if isinstance(body, dict) else None
        die(detail if detail and 400 <= status < 500 else f"move falhou (HTTP {status}): {body}")
    name = session.get("tmux_name") or session.get("display_name") or session_id
    print(f"movendo [{name}] para {_short_host(host)}…")

    for _ in range(MOVE_TIMEOUT_SECONDS // MOVE_POLL_SECONDS):
        time.sleep(MOVE_POLL_SECONDS)
        status, doc = _request("GET", f"{base}/sessions/{session_id}", token=token)
        if status != 200:
            die(f"GET /sessions/{session_id} falhou (HTTP {status}): {doc}")
        moving = doc.get("moving")
        if moving and moving.get("phase") == "failed":
            die(moving.get("error") or "falha ao mover a sessão")
        if not moving:
            if doc.get("host_id") == target:
                print(f"movida para {_short_host(host)} ✅")
                return
            # `moving` foi limpo sem trocar de host (ex.: Retomar no meio).
            die("movimentação interrompida — a sessão continua no host de origem")
    die(f"a sessão não terminou de mover em {MOVE_TIMEOUT_SECONDS}s; "
        f"acompanhe com 'sf list' ou pelo app")


