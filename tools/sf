def wait_running(env, token, name):
    """Poll até a sessão `name` aparecer `running` (criação é assíncrona) ou timeout."""
    deadline = time.time() + CREATE_TIMEOUT_SECONDS
    while time.time() < deadline:
        for s in list_sessions(env, token):
            if (s.get("tmux_name") == name or s.get("display_name") == name) \
                    and (s.get("status") or "").lower() == "running":
                return s
        time.sleep(2)
    return None


def cmd_delegate(args):
    provider = args.provider
    if provider not in PROVIDERS:
        die(f"--provider inválido: {provider}. Use um de {', '.join(PROVIDERS)}")

    name = sanitize_name(args.name) if args.name else slugify_name(args.task)
    if provider == "claude" and not args.model:
        args.model = "claude-tudao"

    # gemini não tem dimensão de esforço → força None.
    effort = None if provider == "gemini" else args.effort
    args.effort = effort

    host_id = None
    auto_info = None
    auto_host = None
    effective_host = args.host or os.environ.get("SF_DEFAULT_HOST")

    if effective_host and effective_host.lower() == "auto":
        env = resolve_env(args)
        token = login(env)
        base = api_base(env)
        local_id = local_host_id()
        need_remote = bool(args.worktree or args.push)
        dir_ok, targets = auto_dir_checker(base, token, local_id, args.dir)
        chosen, ranked, rejected, local_serves = pick_host(fetch_workers(base, token), provider,
                                                          local_id, dir_ok, need_remote)
        summary = _auto_summary(chosen, rejected)
        if chosen is None:
            if need_remote:
                die("--host auto: nenhum host remoto serve. " + " ".join(summary))
            if not local_serves:
                # Auto escolheu ninguém, e o local NÃO aguenta — cair silencioso
                # aqui faria a sessão subir e o worker matar por OOM/cpu. Aborta
                # com os motivos reais pra Diego ver por que Colab/remoto caiu.
                die("--host auto: nenhum host remoto serve E o local não aguenta "
                    "(ram<2G ou cpu>85%). " + " ".join(summary) +
                    "\nDica: clone o projeto no host remoto (gh repo clone, dentro do "
                    "SCAN_ROOTS) e confira com `sf dirs --host <host> <pasta>`.")
            print("host auto → nenhum host atende; rodando local")
            print("\n".join(summary))
            host_id = local_id
        else:
            print("\n".join(summary))
            auto_host = chosen
            auto_info = {
                "auto": True,
                "auto_ranking": [{"host_id": w["host_id"], "score": round(host_score(w), 2)}
                                 for w in ranked],
            }
            host_id = chosen["host_id"]
            if host_id != local_id:
                return delegate_remote(args, env, token, base, chosen, slugify_remote(name),
                                       effort, target=targets[host_id], auto_info=auto_info)
            args.dir = targets[host_id]["path"]
    elif effective_host:
        env = resolve_env(args)
        token = login(env)
        base = api_base(env)
        try:
            host = resolve_host(fetch_workers(base, token), effective_host)
        except ValueError as exc:
            die(str(exc))
        host_id = host["host_id"]
        if host_id != local_host_id():
            # worker slugifica pasta/tmux; usa o mesmo slug p/ branch/registry/handoff
            return delegate_remote(args, env, token, base, host, slugify_remote(name), effort)
    else:
        # Sem --host = ESTE host. Sem isso a API escolhe o worker com heartbeat
        # mais recente, que pode ser outro (ex.: Duck) e a sessão nunca sobe aqui.
        host_id = local_host_id()
    if args.worktree or args.push:
        die("--worktree/--push exigem --host apontando pra OUTRO host (ex.: --host duck)")

    work_dir = os.path.abspath(args.dir or os.getcwd())
    try:
        role = resolve_role(args.role, work_dir)
        context = load_context_file(args.context_file, work_dir)
    except ValueError as exc:
        die(str(exc))

    manifest = build_manifest(args, work_dir, name, role, context)

    env = resolve_env(args)
    token = login(env)
    base = api_base(env)

    parent = detect_parent()

    payload = {
        "name": name,
        "display_name": name,
        "agent_type": provider,
        "work_dir": work_dir,
        "model": args.model,   # None => default do provedor
        "effort": effort,
    }
    # Linka pai→filho: a sessão chefe (dentro do tmux) fica registrada como
    # PAI do worker filho. Fora do tmux o campo é omitido (filho sem pai).
    if parent:
        payload["parent"] = parent
    if host_id:
        payload["host_id"] = host_id
    status, body = _request("POST", f"{base}/sessions", token=token, body=payload)
    if status == 409:
        die(f"já existe uma sessão ativa chamada '{name}'. Use --name outro.")
    if status != 202:
        die(f"criação falhou (HTTP {status}): {body}")

    # POLL até a sessão aparecer com status running (criação é assíncrona).
    session = wait_running(env, token, name)
    if session is None:
        die(f"a sessão não subiu em {CREATE_TIMEOUT_SECONDS}s (não apareceu como running). "
            f"Verifique 'sf check {name}' em instantes ou o worker do SessionFlow.")

    session_id = session["id"]

    # Persiste referências antes de injetar; worker lê só o necessário no worktree.
    try:
        os.makedirs(handoff_dir(work_dir), exist_ok=True)
        with open(manifest_path(work_dir, name), "w", encoding="utf-8") as fh:
            json.dump(manifest, fh, indent=2, ensure_ascii=False)
    except OSError as exc:
        die(f"não consegui gravar manifest: {exc}")

    # Injeta a tarefa + referências + contrato de handoff.
    # Com pai (delegou de dentro do tmux): o filho avisa o pai ao terminar. O
    # worker também avisa (rede de segurança) se o agente esquecer.
    finish = (f"Depois de escrever ambos:\n"
              f"- `sf send {parent} \"✅ HANDOFF {name} status=<status do JSON>\"`\n"
              "Então PARE — não faça mais nada.") if parent else None
    task_text = build_handoff_task(args.task, work_dir, name, manifest_path(work_dir, name),
                                   finish_steps=finish)
    status, body = _request(
        "POST", f"{base}/sessions/{session_id}/input",
        token=token, body={"text": task_text, "enter": True},
    )
    if status != 202:
        die(f"envio da tarefa falhou (HTTP {status}): {body}")

    # Registro local p/ o 'check' resolver por nome. Com --remote, `work_dir`
    # é um caminho na máquina REMOTA (ex.: /mnt/c/DEV do Alvarenga) — pode nem
    # existir aqui (ou ser read-only, ex.: /mnt em macOS). Best-effort: sem
    # registro local, ainda dá pra achar a sessão via 'sf list --remote'.
    reg = {
        "id": session_id,
        "name": name,
        "dir": work_dir,
        "provider": provider,
        "model": args.model,
        "effort": effort,
        "created_at": datetime.now(timezone.utc).isoformat(),
        **(auto_info or {}),
    }
    if auto_info:
        reg["host_id"] = host_id
    try:
        os.makedirs(handoff_dir(work_dir), exist_ok=True)
        with open(registry_path(work_dir, name), "w", encoding="utf-8") as fh:
            json.dump(reg, fh, indent=2, ensure_ascii=False)
    except OSError as exc:
        print(f"aviso: não consegui gravar o registro local: {exc}", file=sys.stderr)

    md_path = handoff_md_path(work_dir, name)
    model_lbl = args.model or "(default)"
    print("delegado ✅")
    print(f"  handle:  {name}  (id={session_id})")
    if auto_host:
        print(f"  host:    {_host_label(auto_host)}")
    print(f"  provedor: {provider} | modelo: {model_lbl}"
          + (f" | effort: {effort}" if effort else ""))
    print(f"  handoff: {md_path}")
    print(f"  acompanhe: sf check {name}"
          + (f" --dir {work_dir}" if work_dir != os.getcwd() else ""))


def delegate_remote(args, env, token, base, host, name, effort, target=None, auto_info=None):
    """Delegação p/ OUTRO host: pasta/worktree lá, manifest inline, registry aqui."""
    # --push sem --worktree é erro
    if args.push and not args.worktree:
        die("--push exige --worktree (senão o push iria pra branch atual do repo remoto)")

    host_id = host["host_id"]
    label = host.get("display_name") or host.get("hostname") or host_id
    local_dir = os.getcwd()
    if not args.dir and target is None:
        die(f"--dir é obrigatório com host remoto; veja `sf dirs --host {args.host}`")
    try:
        role = resolve_role(args.role, local_dir)
        context = load_context_file(args.context_file, local_dir)
        if target is None:
            literal = _is_literal_remote_path(args.dir)
            lookup = [] if literal else fetch_dirs(base, token, host_id, args.dir, 50)
            target = resolve_remote_dir(args.dir, lookup, str(Path.home()))
    except ValueError as exc:
        die(str(exc))
    if args.worktree and target["is_git"] is False:
        die(f"{target['path']} não é repositório git no host {label}; --worktree exige repo")

    manifest = build_manifest(args, target["path"], name, role, context)
    parent = detect_parent()
    payload = {
        "name": name,
        "display_name": name,
        "agent_type": args.provider,
        "work_dir": target["path"],
        "model": args.model,
        "effort": effort,
        "host_id": host_id,
    }
    if parent:
        payload["parent"] = parent
    if args.worktree:
        payload["worktree_branch"] = f"sf/{name}"
    status, body = _request("POST", f"{base}/sessions", token=token, body=payload)
    if status == 409:
        die(f"já existe uma sessão ativa chamada '{name}'. Use --name outro.")
    if status != 202:
        die(f"criação falhou (HTTP {status}): {body}")

    session = wait_running(env, token, name)
    if session is None:
        die(f"a sessão não subiu em {CREATE_TIMEOUT_SECONDS}s no host {label}. Confira: "
            f"host online? --dir {target['path']} existe lá?"
            + (f" é repo git e a branch sf/{name} ainda não existe?" if args.worktree else "")
            + f" Depois: sf check {name}")

    session_id = session["id"]
    # Com --worktree o worker abre em <repo>-clones/<nome>: usa o caminho REAL.
    work_dir = session.get("work_dir") or target["path"]
    branch = f"sf/{name}" if args.worktree else None
    task_text = build_remote_task(args.task, work_dir, name, manifest, parent, args.push, branch=branch)
    status, body = _request(
        "POST", f"{base}/sessions/{session_id}/input",
        token=token, body={"text": task_text, "enter": True},
    )
    if status != 202:
        die(f"envio da tarefa falhou (HTTP {status}): {body}")

    reg = {
        "id": session_id,
        "name": name,
        "host_id": host_id,
        "remote": True,
        "dir": local_dir,
        "work_dir": work_dir,
        "provider": args.provider,
        "model": args.model,
        "effort": effort,
        "push": bool(args.push),
        "worktree": bool(args.worktree),
        "created_at": datetime.now(timezone.utc).isoformat(),
        **(auto_info or {}),
    }
    try:
        os.makedirs(handoff_dir(local_dir), exist_ok=True)
        with open(registry_path(local_dir, name), "w", encoding="utf-8") as fh:
            json.dump(reg, fh, indent=2, ensure_ascii=False)
    except OSError as exc:
        print(f"aviso: não consegui gravar o registro local: {exc}", file=sys.stderr)

    print("delegado ✅ (remoto)")
    print(f"  handle:  {name}  (id={session_id})")
    print(f"  host:    {label} ({host_id})")
    print(f"  pasta:   {work_dir}" + (f"  [branch sf/{name}]" if args.worktree else ""))
    print(f"  entrega: {'git push' if args.push else 'patch via shared-files'}")
    print(f"  acompanhe: sf check {name}")


