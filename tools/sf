# --------------------------------------------------------------------------- #
# comando: command (sessão "Comando" — shell remoto SEM agente LLM)
# --------------------------------------------------------------------------- #
#: Polling da tela: o worker faz ``capture-pane`` a cada CAPTURE_INTERVAL (1s)
#: e upserta ``session_screen`` — 0,8s aqui acompanha esse ritmo sem martelar.
_CMD_POLL_INTERVAL = 0.8
_CMD_TIMEOUT = 120.0
_ANSI_RE = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")


def _strip_ansi(s):
    return _ANSI_RE.sub("", s or "")


def _exact_session(sessions, name):
    """Match EXATO por id/tmux_name/display_name (sem substring).

    ``sf command`` precisa ser determinístico: resolver por substring poderia
    injetar um comando numa sessão Claude de outro trabalho (e aí o "shell
    remoto" vira prompt de agente). Vazio = não existe.
    """
    for s in sessions:
        if s.get("id") == name or s.get("tmux_name") == name \
                or s.get("display_name") == name:
            return s
    return None


def _screen_text(base, token, session_id):
    """``(text, scrollback)`` da tela atual da sessão (GET /sessions/{id}/screen).

    ``scrollback`` é o histórico do tmux + tela (2000 linhas); ``text`` é só a
    tela visível. Preferimos o scrollback pra não perder output que rolou.
    """
    status, body = _request("GET", f"{base}/sessions/{session_id}/screen",
                            token=token, timeout=15)
    if status != 200 or not isinstance(body, dict):
        return "", ""
    return body.get("text") or "", body.get("scrollback") or ""


def _extract_marked(screen, begin, end):
    """Isola o output ENTRE os marcadores; devolve ``(lines, rc|None, done)``.

    Por que marcadores (e não "diff da tela antes/depois"): a tela é um
    snapshot que rola e é re-desenhada, então um diff de prefixo quebra assim
    que o scrollback descarta linhas. O par BEGIN/END é único por nonce e
    sobrevive a qualquer redraw.

    Pega a ÚLTIMA ocorrência de cada marcador porque o texto colado aparece
    Ecoado no terminal ANTES de executar (o echo tem aspas/``printf`` em volta,
    então nunca é igual à linha de output — mas usar a última ocorrência torna
    a busca à prova de qualquer eco).
    """
    lines = screen.split("\n")
    end_idx = None
    rc = None
    for i in range(len(lines) - 1, -1, -1):
        raw = _strip_ansi(lines[i]).strip()
        if raw.startswith(end):
            end_idx = i
            m = re.search(r"rc=(-?\d+)", raw)
            rc = int(m.group(1)) if m else None
            break
    if end_idx is None:
        return [], None, False
    begin_idx = None
    for i in range(end_idx - 1, -1, -1):
        if _strip_ansi(lines[i]).strip() == begin:
            begin_idx = i
            break
    out = lines[begin_idx + 1:end_idx] if begin_idx is not None else lines[:end_idx]
    return [ln.rstrip("\r") for ln in out], rc, True


#: Heartbeat da ponte de comando: durante o polling, o CLI re-registra o
#: vínculo a cada N segundos — isso zera ``last_activity_at`` e segura a ponte
#: viva enquanto um comando longo roda (o TTL ocioso não mata o meio do comando).
_BRIDGE_BEAT_SECONDS = 60


def _ts(value):
    """Epoch de um timestamp ISO (str) — 0 se ausente/inválido."""
    if not value:
        return 0.0
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return 0.0


def _find_command_bridge(sessions, host_id):
    """Ponte de comando VIVA do host — a sessão "comando" que faz a ponte.

    A identidade da ponte é o HOST, não o nome: ``sf command mac`` reusa
    sempre a mesma sessão do Mac (antes cada ``--name`` criava uma sessão
    nova — era a pilha de shells órfãos). ``keep_alive`` (serviço de longa
    duração) NÃO conta como ponte: injetar comando no shell de um serviço
    derrubaria o serviço.
    """
    candidates = [
        s for s in sessions
        if s.get("agent_type") == "command"
        and s.get("host_id") == host_id
        and s.get("status") in ("running", "waiting_input")
        and not s.get("keep_alive")
    ]
    if not candidates:
        return None
    candidates.sort(key=lambda s: _ts(s.get("last_activity_at")), reverse=True)
    return candidates[0]


def _claim_bridge(base, token, session_id, owner=None, keep_alive=None, alias=None):
    """Liga a sessão à ponte de comando: DONA, keep_alive e apelido.

    Também é o HEARTBEAT — o endpoint zera ``last_activity_at``, que é o
    relógio do TTL ocioso (a ponte morre sozinha depois de um tempo sem uso).
    Sempre manda o PUT: mesmo sem dona/apelido, é o "uso" que renova a ponte.
    A dona vai SEMPRE (mesmo None): None = "ninguém é dona" e limpa uma dona
    antiga — a ponte pode ter sido recriada com o mesmo nome.
    """
    body: dict[str, Any] = {"owner": owner}
    if keep_alive is not None:
        body["keep_alive"] = keep_alive
    if alias:
        body["alias"] = alias
    status, resp = _request("PUT", f"{base}/sessions/{session_id}/bridge",
                             token=token, body=body)
    if status != 200:
        print(f"aviso: vínculo da ponte não registrado (HTTP {status}): {resp}",
              file=sys.stderr)


def _free_bridge_name(sessions, base, host_id):
    """Nome de ponte LIVRE no host: ``base``, ou ``base-2``, ``base-3``…

    O worker recusa criar uma sessão com o nome de um pane tmux VIVO (o tmux
    já existe). Um doc PARADO (pane morto) NÃO bloqueia o nome: o worker faz
    upsert no mesmo doc e a ponte renasce. Sem isto, `sf command mac` depois
    de `sf command mac --keep-alive` morria com "sessão tmux já existe".
    """
    used = {
        s.get("tmux_name")
        for s in sessions
        if s.get("host_id") in (None, host_id)
        and s.get("status") in ("running", "waiting_input")
    }
    if base not in used:
        return base
    for i in range(2, 50):
        candidate = f"{base}-{i}"
        if candidate not in used:
            return candidate
    return f"{base}-{uuid.uuid4().hex[:6]}"


def _create_command_session(env, token, base, host, name, work_dir, keep_alive=False):
    """Cria a sessão ``agent_type="command"`` no host e espera ficar running.

    O worker NÃO lança agente nenhum: o pane já é o shell do host (ver
    ``command_consumer._handle_create``). Sem ``--dir``, abre no HOME do host.
    """
    payload = {
        "name": name,
        "display_name": name,
        "agent_type": "command",
        "host_id": host["host_id"],
        "keep_alive": bool(keep_alive),
    }
    if work_dir:
        payload["work_dir"] = work_dir
    status, body = _request("POST", f"{base}/sessions", token=token, body=payload)
    if status == 409:
        # Corrida: a ponte do MESMO host nasceu entre a listagem e o POST (a
        # API recusa 2ª ponte por host) → REAPROVEITA a que existe em vez de
        # die(). Uma ponte de outro host não conta.
        existing = _find_command_bridge(list_sessions(env, token), host["host_id"])
        if existing is not None:
            return existing
        die(f"já existe uma sessão ativa chamada '{name}'. Use --name outro.")
    if status != 202:
        die(f"criação da sessão de comando falhou (HTTP {status}): {body}")
    session = wait_running(env, token, name)
    if session is None:
        die(f"a sessão '{name}' não subiu em {CREATE_TIMEOUT_SECONDS}s. "
            f"Confira 'sf check {name}' ou o worker do host.")
    return session


def cmd_command(args):
    """Roda um comando num shell de OUTRO host, sem Claude/agente nenhum no meio.

    É a sessão "Comando": um pane tmux com o shell do host alvo (``agent_type
    ="command"``), criado/reusado sob demanda. Casos de uso: abrir o Chrome DO
    Mac via browser-harness a partir da Duck, ``screencapture`` remoto, rodar
    uma skill que só existe lá, mover arquivo entre máquinas — tudo sem pagar
    um turno de LLM nem esperar um agente terminar.

    Saída: o worker só expõe a TELA da sessão, então injetamos o comando entre
    dois marcadores com nonce (``SF_BEGIN_<n>`` / ``SF_END_<n> rc=<code>``) e
    fazemos polling em ``GET /sessions/{id}/screen`` até o marcador de fim
    aparecer — o que está entre eles É o output do comando, e o ``rc`` vira o
    exit code deste CLI.
    """
    env = resolve_env(args)
    token = login(env)
    base = api_base(env)
    workers = fetch_workers(base, token)
    try:
        host = resolve_host(workers, args.host, allow_offline=False)
    except ValueError as exc:
        die(str(exc))
    host_id = host["host_id"]
    host_lbl = _host_label(host)

    # A PONTE é identificada pelo HOST alvo, não pelo nome: `sf command mac`
    # reusa SEMPRE a mesma sessão do Mac. O nome é rótulo (p/ `sf send`).
    name = sanitize_name(args.name) if args.name else \
        sanitize_name(f"cmd-{slugify_remote(host.get('display_name') or host.get('hostname') or host_id)}")

    sessions = list_sessions(env, token)
    session = _find_command_bridge(sessions, host_id)
    alias = sanitize_name(args.name) if args.name else None
    keep_alive = bool(getattr(args, "keep_alive", False))
    if session is None:
        # Sem ponte viva neste host → cria uma com o nome pedido (livre no
        # host: o worker recusa nome repetido e o tmux já existe).
        session = _create_command_session(
            env, token, base, host,
            _free_bridge_name(sessions, name, host_id), args.dir,
            keep_alive=keep_alive,
        )
        # o nome pedido só é apelido se a ponte NÃO se chama assim
        if (session.get("tmux_name") or "") == name:
            alias = None
    elif args.dir:
        print(f"aviso: --dir ignorado, a ponte de {host_lbl} já existe "
              f"(work_dir={session.get('work_dir') or '?'})", file=sys.stderr)

    # `--name` numa ponte já viva: o nome pedido vira APELIDO da ponte (dá pra
    # dirigir com `sf send <apelido>`), sem renomear o tmux — o rename
    # derrubaria o cwd e o ambiente do shell.
    if alias and alias == (session.get("tmux_name") or ""):
        alias = None
    # DONA da ponte: a sessão que está usando ela agora. Só vale se for uma
    # sessão de verdade do SessionFlow — um tmux solto (fora do app) não
    # seria "viva" pra API e mataria a ponte no próximo tick.
    owner = detect_parent()
    known = {s.get("tmux_name") for s in sessions}
    if owner and owner not in known:
        owner = None
    # Vínculo: dona + keep_alive + apelido. É também o heartbeat que segura
    # o TTL ocioso.
    _claim_bridge(base, token, session["id"], owner=owner, alias=alias,
                  keep_alive=True if getattr(args, "keep_alive", False) else None)
    name = session.get("tmux_name") or name
    session_id = session["id"]

    # --tail: não executa nada, só imprime a tela atual da sessão (o que o
    # comando anterior deixou lá / o que está rodando agora).
    if args.tail:
        visible, scrollback = _screen_text(base, token, session_id)
        text_now = scrollback or visible
        if not text_now.strip():
            print(f"(tela vazia em [{name}] — nada capturado ainda)")
            return
        limit = max(1, args.tail_lines)
        for ln in text_now.split("\n")[-limit:]:
            sys.stdout.write(_strip_ansi(ln) + "\n")
        return

    # Comando: argv, stdin ('-') ou nada (só garante a sessão de pé).
    text = args.command
    if text == "-":
        text = sys.stdin.read()
    if not text or not text.strip():
        print(f"sessão de comando ✅ [{name}] em {host_lbl}")
        print(f"  id:      {session_id}")
        print(f"  dir:     {session.get('work_dir') or '(home do host)'}")
        print(f"  use:     sf command {args.host} \"ls ~/Documents\"")
        print(f"  ou dirija à mão: sf send {name} \"<comando>\"")
        return

    nonce = uuid.uuid4().hex[:8]
    begin, end = f"SF_BEGIN_{nonce}", f"SF_END_{nonce}"
    # O comando roda num SUB-SHELL: ``exit N`` (ou um ``source`` que termine em
    # exit) MATARIA o shell do pane — e com ele a sessão nomeada inteira, que
    # viraria timeout sem rc. Num sub-shell, ``exit`` só encerra o sub-shell, o
    # ``$?`` volta pro pai e o marcador END é SEMPRE impresso.
    # O rc do comando é capturado DENTRO do sub-shell (antes do pwd), senão o
    # pwd sobrescreve o status e um comando que falha volta com rc=0.
    # O ``pwd`` final volta pro shell pai pra preservar o cwd da sessão nomeada
    # (ex.: ``cd repo && npm test`` deixa o repo como cwd). Ele roda DEPOIS do
    # END, então um erro ali nunca vaza pro output capturado.
    # Tudo num paste só: se o shell suportar bracketed paste, as quebras de
    # linha viram dado (heredoc/multilinha funcionam); se não suportar, cada
    # linha executa em sequência — dá certo nos dois casos.
    cwd_file = f"${{TMPDIR:-/tmp}}/.sf_cwd_{nonce}"
    wrapped = (
        f"__sf_tmp={cwd_file}\n"
        f"printf '{begin}\\n'\n"
        f"( {text.rstrip(chr(10))}\n"
        f"  __sf_inner=$?\n"
        f"  pwd > \"$__sf_tmp\"\n"
        f"  exit $__sf_inner\n"
        f" )\n"
        f"__sf_rc=$?\n"
        f"printf '{end} rc=%s\\n' \"$__sf_rc\"\n"
        f"[ -f \"$__sf_tmp\" ] && cd \"$(cat \"$__sf_tmp\")\"; rm -f \"$__sf_tmp\"; "
        f"unset __sf_tmp __sf_rc __sf_inner"
    )

    status, body = _request(
        "POST", f"{base}/sessions/{session_id}/input",
        token=token, body={"text": wrapped, "enter": True},
    )
    if status != 202:
        die(f"envio do comando falhou (HTTP {status}): {body}")

    if args.no_wait:
        print(f"comando enviado ✅ -> [{name}] em {host_lbl} (sem esperar)")
        print(f"  acompanhe: sf command {args.host} --tail  |  app: sessão {name}")
        return

    timeout = args.timeout or _CMD_TIMEOUT
    deadline = time.monotonic() + timeout
    last = ""
    last_beat = time.monotonic()
    while time.monotonic() < deadline:
        time.sleep(_CMD_POLL_INTERVAL)
        if time.monotonic() - last_beat > _BRIDGE_BEAT_SECONDS:
            # Heartbeat: re-registra a dona → zera o relógio do TTL ocioso
            # (senão um comando longo veria a ponte morrer no meio).
            _claim_bridge(base, token, session_id, owner=owner)
            last_beat = time.monotonic()
        visible, scrollback = _screen_text(base, token, session_id)
        last = scrollback or visible
        out_lines, rc, done = _extract_marked(last, begin, end)
        if done:
            for ln in out_lines:
                sys.stdout.write((_strip_ansi(ln) if not args.color else ln) + "\n")
            sys.stdout.flush()
            if rc is None:
                print(f"aviso: output capturado mas sem rc (marcador truncado?)",
                      file=sys.stderr)
                return
            if rc != 0:
                print(f"-- comando saiu com rc={rc} em {host_lbl}", file=sys.stderr)
            sys.exit(rc)
    # Timeout: mostra o que a tela tem (ajuda a ver se o comando ainda roda ou
    # se travou pedindo algo) e sai com código próprio.
    tail = "\n".join(_strip_ansi(ln) for ln in last.split("\n")[-40:])
    print(f"sf: timeout de {timeout:.0f}s aguardando o comando terminar em "
          f"[{name}]. A sessão continua rodando lá — o comando NÃO foi cancelado.",
          file=sys.stderr)
    if tail.strip():
        print("---- tela atual ----", file=sys.stderr)
        print(tail, file=sys.stderr)
    sys.exit(2)


